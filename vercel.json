{
  "version": 2,
  "public": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "functions/pix-blackcat.js": {
      "runtime": "nodejs18.x"
    },
    "functions/check-payment-blackcat.js": {
      "runtime": "nodejs18.x"
    },
    "functions/webhook-blackcat.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/pix-blackcat",
      "dest": "/functions/pix-blackcat.js"
    },
    {
      "src": "/api/check-payment-blackcat",
      "dest": "/functions/check-payment-blackcat.js"
    },
    {
      "src": "/api/webhook-blackcat",
      "dest": "/functions/webhook-blackcat.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
